#!/bin/bash

set -e

FORWARD_RECORDS_FILE="/etc/unbound/forward-zones.conf"
ONLINE_FILE="/var/run/unbound/horizon/horizon.online"
OFFLINE_FILE="/var/run/unbound/horizon/horizon.offline"
STATE_DIR="/var/run/unbound/horizon"

PROJECT_NAME="{{ unbound_compose_project_name }}"

mkdir -p "${STATE_DIR}"

is_online=1

if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
  desired="online"
  desired_file="${ONLINE_FILE}"
else
  desired="offline"
  desired_file="${OFFLINE_FILE}"
fi

if [[ ! -f "${desired_file}" ]]; then
  mkdir -p "$(dirname "${desired_file}")"
  touch "${desired_file}"
  touch "${ONLINE_FILE}" 2>/dev/null || true
  touch "${OFFLINE_FILE}" 2>/dev/null || true
  rm -f "${OFFLINE_FILE}" "${ONLINE_FILE}"
  touch "${desired_file}"
fi
