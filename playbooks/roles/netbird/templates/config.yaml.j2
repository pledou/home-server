# Combined NetBird Server Configuration (Simplified)
# Generated by getting-started.sh

server:
  listenAddress: ":80"
  exposedAddress: "https://vpn.{{ app_domain_name }}:443"
  stunPorts:
    - ${{ netbird_stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "$NETBIRD_RELAY_AUTH_SECRET"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://vpn.{{ app_domain_name }}/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "{{ netbird_session_cookie_encryption_key }}"
    dashboardRedirectURIs:
      - "https://vpn.{{ app_domain_name }}/nb-auth"
      - "https://vpn.{{ app_domain_name }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.16.0.0/12" # Trust Docker networks

  store:
    engine: "sqlite"
    encryptionKey: "{{ netbird_datastore_encryption_key }}"