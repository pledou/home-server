# NetBird Management Server Configuration
# Auto-generated by Ansible

# Logging
NETBIRD_LOGLEVEL={{ netbird_log_level }}
NETBIRD_LOG_FORMAT=json

# Network Configuration
NETBIRD_BIND_ADDR=0.0.0.0:{{ netbird_management_port }}
NETBIRD_NETWORK_CIDR={{ netbird_network_cidr }}

# DNS Configuration
NETBIRD_DNS_ENABLED={{ netbird_dns_enabled | lower }}
NETBIRD_DNS_PORT={{ netbird_dns_port }}
NETBIRD_DNS_SERVERS={{ netbird_dns_servers | join(',') }}

# OIDC/Authentik
NETBIRD_JWT_ISSUER={{ netbird_oidc_issuer }}
NETBIRD_JWT_AUDIENCE={{ netbird_oidc_audience }}
NETBIRD_OAUTH2_CLIENT_ID={{ netbird_oidc_client_id }}
NETBIRD_OAUTH2_CLIENT_SECRET={{ netbird_oidc_client_secret | default('') }}
NETBIRD_OAUTH2_REDIRECT_URI={{ netbird_oidc_redirect_uri }}
NETBIRD_OAUTH2_ISSUER={{ netbird_oidc_issuer }}

# Security
NETBIRD_CERTIFICATE_EXPIRATION={{ netbird_certificate_expiration }}
NETBIRD_CERTIFICATE_KEY_EXPIRATION={{ netbird_certificate_expiration }}
NETBIRD_PEER_LOGIN_EXPIRATION={{ netbird_peer_login_expiration }}
NETBIRD_IDP_SIGN_KEY_REFRESH_DURATION={{ netbird_idp_sign_key_refresh_duration }}

# Database
NETBIRD_DB_ENGINE={{ netbird_db_engine }}
NETBIRD_DB_PATH={{ netbird_db_path }}

# Features
NETBIRD_IDEMPOTENT_NETWORK_CONFIG=true
NETBIRD_RELAY_ENABLED={{ netbird_relay_enabled | lower }}
